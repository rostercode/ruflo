# SENTNL Ruflo Sandbox — Environment
# 
# PRIMARY MODE: Ruflo runs as an MCP server inside Claude Code in VS Code.
# In this mode, NO API key is needed here — Claude Code handles the AI calls.
#
# STANDALONE MODE (optional, advanced): If you want to run Ruflo's daemon
# independently (outside Claude Code), uncomment and set a key below.
# Use a low-limit key — never your main Anthropic key.
#
# ANTHROPIC_API_KEY=sk-ant-xxx

# Lock down auto-update and force debug mode
CLAUDE_FLOW_AUTO_UPDATE=false
CLAUDE_FLOW_DEBUG=true
NODE_ENV=development
