# SENTNL SANDBOX — Ruflo Environment
# This is the ONLY env file Ruflo should ever see.
# NO Supabase, Telegram, OpenAI, Google, Stripe, or financial keys. EVER.

# Sandbox Anthropic key — set a low-limit key here
ANTHROPIC_API_KEY=

# Lock down auto-update and force debug mode
CLAUDE_FLOW_AUTO_UPDATE=false
CLAUDE_FLOW_DEBUG=true
NODE_ENV=development

# That's it. Nothing else goes here.
